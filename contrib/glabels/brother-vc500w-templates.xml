<?xml version="1.0"?>
<!--
  gLabels templates for the Brother VC-500W (continuous ZINK tape).
  Width = cassette tape width, height = label length.
  For text running along the tape pick the rotated orientation in the
  "New label" dialog. Print through a vc500w queue (contrib/cups).
  Install: copy to ~/.config/libglabels/templates/
-->
<Glabels-templates>
  <Template brand="Brother" part="VC-500W 9x30" size="Other" width="9mm" height="30mm" description="VC-500W 9 mm × 30 mm (CZ-1001)">
    <Meta category="label"/>
    <Meta category="rectangle-label"/>
    <Label-rectangle id="0" width="9mm" height="30mm" round="0mm" x_waste="0mm" y_waste="0mm">
      <Markup-margin size="0.5mm"/>
      <Layout nx="1" ny="1" x0="0mm" y0="0mm" dx="0mm" dy="0mm"/>
    </Label-rectangle>
  </Template>
